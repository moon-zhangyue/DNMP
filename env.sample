# Nginx Exporter
# NGINX_EXPORTER_PORT=9113

# PHP-FPM Exporter
# PHP_FPM_EXPORTER_PORT=9253

# Grafana
GRAFANA_VERSION=latest
GRAFANA_PORT=3000
GRAFANA_DATA_DIR=./data/grafana


# Consul
CONSUL_VERSION=1.15
CONSUL_UI_PORT=8500
CONSUL_SERVER_PORT=8300
CONSUL_DNS_PORT=8600
CONSUL_DATA_DIR=./data/consul
CONSUL_CONFIG_DIR=./services/consul/config

# Kafka Exporter
KAFKA_EXPORTER_PORT=9308

###########################################
# TDengine
###########################################
TDENGINE_VERSION=3.2.3.0
TDENGINE_HOST_PORT=6030
TDENGINE_DATA_DIR=./data/taos
TDENGINE_LOG_DIR=./logs/taos

###########################################
# InfluxDB - 时序数据库
###########################################
INFLUXDB_VERSION=2.7-alpine
INFLUXDB_HOST_PORT=8086
INFLUXDB_DATA_DIR=./data/influxdb
# 注释掉此行，InfluxDB 2.x不使用此配置文件
# INFLUXDB_CONFIG_FILE=./services/influxdb/influxdb.conf
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=admin123
INFLUXDB_ORG=myorg
INFLUXDB_BUCKET=mybucket
INFLUXDB_ADMIN_TOKEN=my-super-secret-auth-token

###########################################
# Yearning - MySQL审核平台
###########################################
YEARNING_VERSION=latest
YEARNING_HOST_PORT=8000
YEARNING_CONF_FILE=./services/yearning/conf.toml
YEARNING_DATA_DIR=./data/yearning
